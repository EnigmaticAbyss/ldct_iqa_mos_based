{
  "train_mode": "trl_grpo",
  "model_name": "google/medgemma-1.5-4b-it",
  "base_model_name": "google/medgemma-1.5-4b-it",
  "adapter_model_dir": "output/model/medgemma15_iqa_sft_test",

  "dataset_format": "arrow",
  "load_prebuilt_sft_dataset": null,
  "data_dir": "datasets/processed",
  "train_dataset_dir": "datasets/processed/sft_train_dataset",
  "val_dataset_dir": "datasets/processed/sft_val_dataset",
  "train_json_path": "datasets/processed/base_train.jsonl",
  "val_json_path": "datasets/processed/base_val.jsonl",

  "system_prompt": "You are a medical image quality assessment assistant.",
  "user_text": "Predict the MOS score as JSON like {\"rating\": 2.5}.",

  "output_dir": "output/model/medgemma15_iqa_grpo_test",
  "logging_dir": "logs/grpo",
  "seed": 42,

  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 4,
  "gradient_accumulation_steps": 4,
  "num_train_epochs": 1.0,
  "max_steps": -1,

  "learning_rate": 0.00001,
  "weight_decay": 0.0,
  "warmup_ratio": 0.1,
  "optim": "adamw_torch",
  "max_grad_norm": 1.0,

  "logging_steps": 10,
  "save_steps": 100,
  "eval_steps": 100,

  "eval_strategy": "steps",
  "save_strategy": "steps",
  "save_total_limit": 3,
  "report_to": ["tensorboard"],

  "fp16": false,
  "bf16": true,
  "gradient_checkpointing": true,
  "gradient_checkpointing_kwargs": {"use_reentrant": false},
  "remove_unused_columns": false,

  "max_prompt_length": null,
  "max_completion_length": 32,
  "num_generations": 4,
  "num_generations_eval": 4,
  "temperature": 0.7,
  "top_p": 1.0,
  "top_k": 0,
  "min_p": null,
  "repetition_penalty": 1.0,
  "generation_kwargs": null,

  "beta": 0.0,
  "num_iterations": 1,
  "epsilon": 0.2,
  "loss_type": null,
  "scale_rewards": null,
  "sync_ref_model": false,
  "log_completions": false,

  "use_vllm": false,
  "vllm_mode": "colocate",
  "vllm_gpu_memory_utilization": 0.3,
  "vllm_tensor_parallel_size": 1,

  "use_4bit": true,
  "use_8bit": false,
  "bnb_compute_dtype": "bf16",
  "torch_dtype": null,

  "lora_enabled": true,
  "lora_scope": "both",
  "lora_coverage": "linear_only",
  "lora_include_patterns": null,
  "lora_exclude_patterns": null,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,

  "mos_min": 0.0,
  "mos_max": 4.0,
  "reward_kind": "neg_abs_error",
  "reward_scale": 1.0,
  "reward_offset": 0.0,
  "missing_reward": -4.0,
  "clamp_prediction": true
}
