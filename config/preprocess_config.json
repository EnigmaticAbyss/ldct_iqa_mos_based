{
  "log_dir": "logs/preprocess",
  "log_level": "INFO",

  "mode": "to_png",
  "norm": "minmax",
  "p_low": 0.5,
  "p_high": 99.5,
  "resize": false,
  "resize_w": 512,
  "resize_h": 512,

  "splits": {
    "train": {
      "tif_dir": "datasets/ct_tif/train/LDCT",
      "png_dir": "datasets/ct_PNG/train/LDCT",
      "mos_json": "datasets/mos/train_ldct_mos.json",
      "out_jsonl": "datasets/processed/base_train.jsonl",
      "make_val_split": true,
      "val_ratio": 0.1,
      "seed": 42
    },

    "test": {
      "tif_dir": "datasets/ct_tif/test/LDCT",
      "png_dir": "datasets/ct_PNG/test/LDCT",
      "mos_json": "datasets/mos/test_ldct_mos.json",
      "out_jsonl": "datasets/processed/base_test.jsonl",
      "make_val_split": false
    }
  }
}
